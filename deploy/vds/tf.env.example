# Tunc Fitness backend (tf-backend). Copy to tf.env, fill in, chmod 600. Never committed.
# JWT signing key: openssl rand -hex 48
APP_JWT_SECRET=
# First admin, created only while the database has no admin at all. After the first login change the password in
# Ayarlar, empty BOOTSTRAP_ADMIN_PASSWORD here and recreate the container (docker compose up -d tf-backend).
BOOTSTRAP_ADMIN_EMAIL=admin
BOOTSTRAP_ADMIN_PASSWORD=
# Public site address without a trailing slash; used in page titles, share previews, sitemap and robots.txt.
APP_PUBLIC_BASE_URL=https://tuncfitness.duckdns.org
