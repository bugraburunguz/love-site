# FC Assist backend variables (DB_* come from compose.yml). Copy to fc.env, fill in, chmod 600.
# Same list as FCarrierTacticBuilderBackend/docs/deploy/RAILWAY.md section 5, without the Railway references.
JWT_SECRET=
ADMIN_KEY=
WEB_BASE_URL=https://FC_DOMAIN
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
FCAREER_FREE_BETA=true
FCAREER_DAILY_CREDITS=30
FCAREER_TRUST_PROXY=true
BILLING_STUB_ENABLED=false
FCAREER_BOOTSTRAP_ADMIN_EMAIL=
INGESTION_PROVIDER=ea-site
INGESTION_GAME_VERSION=27
FCAREER_RATELIMIT_REGISTER_DAILY_PER_IP=5
# only with the "ml" profile
ML_BASE_URL=
ML_SHARED_SECRET=
