# Garage (S3) for love-site, one node. Copy to garage.toml and put a fresh secret in rpc_secret:
#   sed "s/CHANGE_ME_RPC_SECRET/$(openssl rand -hex 32)/" garage.toml.example > garage.toml && chmod 600 garage.toml
# The S3 API is reached only through Caddy (https://LOVE_S3_DOMAIN); no port is published.
metadata_dir = "/var/lib/garage/meta"
data_dir = "/var/lib/garage/data"
db_engine = "sqlite"
replication_factor = 1

rpc_bind_addr = "[::]:3901"
rpc_public_addr = "127.0.0.1:3901"
rpc_secret = "CHANGE_ME_RPC_SECRET"

[s3_api]
# love.env: S3_REGION=garage
s3_region = "garage"
api_bind_addr = "[::]:3900"
