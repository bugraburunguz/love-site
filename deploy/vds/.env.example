# compose.yml interpolation. Copy to .env, fill in, chmod 600. Passwords: openssl rand -hex 24 (hex: no characters a URL
# or a shell would trip over).
ACME_EMAIL=
LOVE_DOMAIN=
LOVE_S3_DOMAIN=
FC_DOMAIN=

POSTGRES_PASSWORD=
LOVE_DB_PASSWORD=
FC_DB_PASSWORD=
# only with the "ml" profile; the same value goes to FC's ML_SHARED_SECRET in fc.env
FC_ML_SHARED_SECRET=

LOVE_SRC=/srv/src/love-site
FC_BACKEND_SRC=/srv/src/FCarrierTacticBuilderBackend
FC_WEB_SRC=/srv/src/FCarrierTacticBuilderWeb
