# HTTPS for every name below: Caddy gets and renews the Let's Encrypt certificates itself (ports 80 and 443 open,
# DNS A record of each name pointing at the server). Names and the e-mail come from compose.yml (.env).
{
	email {$ACME_EMAIL}
}

# love-site. Caddy writes the client address into X-Forwarded-For itself (incoming values are not trusted), so the
# rightmost entry the app reads (ClientIp) is the real client.
#
# The API only takes small JSON bodies (photos, videos and songs go straight to the bucket with presigned URLs), so a
# body over 1 MB is refused here (413) before it reaches the app.
{$LOVE_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 1MB
	}
	reverse_proxy love-web:8080
}

# love-site's bucket. The browser loads photos and uploads originals here with presigned URLs; the Host header is
# passed through unchanged, so the signatures stay valid. No size limit: originals and videos can be large.
{$LOVE_S3_DOMAIN} {
	reverse_proxy garage:3900
}

# Container logs (Dozzle). Logs carry e-mail addresses and the like, so both are behind a password; LOGS_PASSWORD_HASH
# is a bcrypt hash (caddy hash-password), the password itself is never stored on the server.
{$LOGS_DOMAIN} {
	basic_auth {
		{$LOGS_USER} {$LOGS_PASSWORD_HASH}
	}
	reverse_proxy logs-all:8080
}

{$LOGS_FC_DOMAIN} {
	basic_auth {
		{$LOGS_USER} {$LOGS_PASSWORD_HASH}
	}
	reverse_proxy logs-fc:8080
}

# Tunc Fitness: Caddy (SPA + /api proxy) behind Caddy. tf-web trusts X-Forwarded-For only from private ranges (this
# Caddy), so the backend sees the real client address. Media uploads (POST /api/v1/media) may be videos up to 30 MB, so
# only that path accepts bodies up to 31 MB; every other request stays at 6 MB (tf-web applies the same limits).
# TF_DOMAIN may list several names; www.<name> answers with a permanent redirect to <name>, path and query kept. Only
# names listed in TF_DOMAIN reach this block, so the redirect target is always one of them.
{$TF_DOMAIN} {
	@tfWww header_regexp tfWww Host ^(?i)www\.([^:]+)
	redir @tfWww https://{re.tfWww.1}{uri} permanent
	@tfMediaUpload {
		method POST
		path /api/v1/media
	}
	handle @tfMediaUpload {
		request_body {
			max_size 31MB
		}
		reverse_proxy tf-web:80
	}
	handle {
		request_body {
			max_size 6MB
		}
		reverse_proxy tf-web:80
	}
}

# FC Assist: nginx (SPA + /api proxy) behind Caddy.
{$FC_DOMAIN} {
	encode zstd gzip
	reverse_proxy fc-web:80 {
		header_up X-Real-IP {remote_host}
	}
}
