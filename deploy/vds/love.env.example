# love-site variables (love-web and love-worker). Copy to love.env, fill in, chmod 600.
APP_PUBLIC_URL=https://LOVE_DOMAIN
ADMIN_EMAIL=
PRIVACY_CONTACT_EMAIL=

PGHOST=postgres
PGPORT=5432
PGDATABASE=love
PGUSER=love
# same value as LOVE_DB_PASSWORD in .env
PGPASSWORD=

# Garage, through Caddy: the browser and the app use the same address
S3_ENDPOINT=https://LOVE_S3_DOMAIN
S3_BUCKET=lovesite
S3_REGION=garage
S3_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Nightly backup OFF the server (Cloudflare R2, Backblaze B2 ...): originals, album songs, daily database dump.
# Without it a lost disk loses every photo.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=auto

# Required at start-up (UserSeeder). An account that already exists is left as it is, the password is only used to create
# a missing one: on the migrated database use the same e-mails and names as on Railway and a NEW random password
# (openssl rand -hex 24), not the old one.
USER1_EMAIL=
USER1_NAME=
USER1_PASSWORD=
USER2_EMAIL=
USER2_NAME=
USER2_PASSWORD=
