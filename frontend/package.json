{
  "name": "love-site-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:mobile": "tsc -b && vite build --mode mobile --outDir dist-mobile",
    "cap:sync": "npm run build:mobile && cap sync",
    "cap:assets": "capacitor-assets generate --assetPath resources --iconBackgroundColor \"#E9D7B0\" --iconBackgroundColorDark \"#E9D7B0\" --splashBackgroundColor \"#E4D0A9\" --splashBackgroundColorDark \"#E4D0A9\""
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.5.3",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cinzel-decorative": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/creepster": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/mountains-of-christmas": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/shantell-sans": "^5.3.0",
    "hash-wasm": "^4.12.0",
    "interactjs": "^1.10.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
