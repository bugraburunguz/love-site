# Database (Railway Postgres provides these automatically)
PGHOST=localhost
PGPORT=5432
PGDATABASE=lovesite
PGUSER=lovesite
PGPASSWORD=change-me

# Storage bucket (Railway: reference the Bucket service variables, see README)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# The app's public address (scheme + host). Invite links and the bucket CORS origin derive from it.
APP_PUBLIC_URL=http://localhost:5173
# Optional: origins allowed to upload directly to the bucket (defaults to APP_PUBLIC_URL)
# APP_ALLOWED_ORIGINS=http://localhost:5173
# Set to true after the custom domain works: page requests on *.up.railway.app get a 301 to APP_PUBLIC_URL
REDIRECT_TO_PUBLIC_URL=false
# Leave false for virtual-hosted style (Railway); true for MinIO / path-style buckets
S3_PATH_STYLE=false

# Server (Railway sets PORT)
PORT=8080

# Set to false only for plain-http local development
COOKIE_SECURE=true

# Local development: SPRING_PROFILES_ACTIVE=local
# SPRING_PROFILES_ACTIVE=local

# The two users, seeded on startup if they do not exist yet (existing users are never modified)
USER1_EMAIL=
USER1_NAME=
USER1_PASSWORD=
USER2_EMAIL=
USER2_NAME=
USER2_PASSWORD=

# Phase 3.5 (spaces)
ADMIN_EMAIL=
INITIAL_SPACE_NAME=Bizim Alanımız
INITIAL_SPACE_LIMIT_GB=400

# Phase 6: nightly backup to a second S3-compatible bucket (e.g. Cloudflare R2). Leave empty to switch backup off.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=auto
BACKUP_S3_PATH_STYLE=false
